PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hrms
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=true
BACKUP_DIR=./backups
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (for Whisper STT fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# Voice Interview Settings
VOICE_INTERVIEW_MAX_QUESTIONS=5
VOICE_INTERVIEW_SCORING_MODEL=llama-3.3-70b-versatile

# Chatbot Settings  
CHATBOT_SESSION_TTL_MINUTES=30
CHATBOT_MAX_MESSAGES_PER_SESSION=50
CHATBOT_SCREENING_MODE=true

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30

# Auto-Screening Thresholds
AUTO_SCREEN_TRIGGER_COUNT=10
AUTO_ADVANCE_MIN_GRADE=A
AUTO_ADVANCE_MIN_CONFIDENCE=0.8

# Admin defaults
ADMIN_NAME=HRMS Admin
ADMIN_EMAIL=admin@hrms.com
ADMIN_PASSWORD=Admin@123
