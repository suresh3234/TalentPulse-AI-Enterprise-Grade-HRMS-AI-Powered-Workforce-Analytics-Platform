# ==========================================
# Backend API Environment Variables
# Location: backend/.env
# ==========================================
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hrms
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development

# Optional AI Providers for the backend (if using built-in controllers instead of the separate Python ai-service)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=


# ==========================================
# Frontend Environment Variables
# Location: frontend/.env
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api


# ==========================================
# AI Service Environment Variables (Python)
# Location: ai-service/.env
# ==========================================
ENVIRONMENT=dev

# Make sure you provide your Groq API key to use the standalone python AI service
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_PROVIDER=groq
AI_TIMEOUT=10
AI_MAX_RETRIES=3
